# Copy to agent/.env and fill in YOUR project id.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
# Gemini 3.x models are served from the global endpoint.
GOOGLE_CLOUD_LOCATION=global
MODEL=gemini-3.6-flash

A4I_DATASET=a4i_health
COUNTY_NAME=Fulton

# Optional: path to the downloaded MCP Toolbox binary (faster than npx)
# TOOLBOX_CMD=/Users/you/bin/toolbox
